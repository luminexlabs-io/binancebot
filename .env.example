# Copy to .env and fill in real values.
BINANCE_SQUARE_OPENAPI_KEY=your_square_openapi_key
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...
GEMINI_API_KEY=...
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
GEMINI_TEXT_MODEL=gemini-2.0-flash
POST_SCHEDULE_CRON=0 * * * *
POST_TIMEZONE=UTC
POST_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
MAIN_SYMBOL=BTCUSDT
PORT=3000
DRY_RUN=false
POST_RETRIES=2
POST_RETRY_DELAY_MS=900000
